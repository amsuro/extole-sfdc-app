<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Extole Writeback Lock</label>
    <pluralLabel>Extole Writeback Locks</pluralLabel>
    <description>Short-lived mutex rows. The Extole writeback inserts one per email so concurrent deliveries for the same person run one at a time instead of creating duplicate records. Rows are deleted in the same transaction and are normally never visible.</description>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <nameField>
        <label>Lock Name</label>
        <type>AutoNumber</type>
        <displayFormat>LOCK-{0000}</displayFormat>
        <startingNumber>0</startingNumber>
    </nameField>
    <enableActivities>false</enableActivities>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableHistory>false</enableHistory>
    <enableBulkApi>false</enableBulkApi>
    <enableSharing>false</enableSharing>
    <enableStreamingApi>false</enableStreamingApi>
</CustomObject>
